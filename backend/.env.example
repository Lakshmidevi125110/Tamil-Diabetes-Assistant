# Copy this file to .env and fill in real values. Never commit .env.

# Server configuration
PORT=8000
DEBUG=False

# Frontend origins allowed to call the API (comma-separated).
# Add your Vercel URL in production, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex for changing URLs such as Vercel preview deployments
# CORS_ORIGIN_REGEX=^https://tamil-diabetes-assistant(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# Neon PostgreSQL connection string (reserved; not used yet)
# e.g. postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Google Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional Multi-Provider Fallbacks
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
XAI_API_KEY=
GROK_MODEL=grok-beta

# LLM Selection & Fallback
PRIMARY_LLM=gemini
SECONDARY_LLM=

# Vector RAG Configuration
VECTOR_STORE=local_file
EMBEDDING_PROVIDER=gemini
RAG_TOP_K=3
RAG_MIN_SCORE=0.45

# Allowed Medical Knowledge Sources (comma-separated list of approved authorities)
ALLOWED_KNOWLEDGE_SOURCES=WHO,ICMR,MoHFW,CDC
