# Virtual environment
venv/
env/
ENV/

# Secrets and environment variables
.env
*.env.local

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Audio files (temporary voice files)
static/audio/*.mp3
static/audio/*.wav
*.mp3
*.wav

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Vector RAG Index (keep prebuilt knowledge_index.json for Render ephemeral deployment)
data/index/*
!data/index/knowledge_index.json
